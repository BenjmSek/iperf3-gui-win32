#include "resource.h"
#include <winver.h>

IDI_APPICON ICON "app.ico"

#define VER_FILEVERSION    1,1,0,0
#define VER_FILEVERSION_STR "1.1.0.0"
#define VER_PRODUCTVERSION  1,1,0,0
#define VER_PRODUCTVERSION_STR "1.1.0.0"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    VER_FILEVERSION
PRODUCTVERSION VER_PRODUCTVERSION
FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
FILEFLAGS      0
FILEOS         VOS__WINDOWS32
FILETYPE       VFT_APP
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080403B0"  /* 0x0804 = zh-CN, 0x03B0 = UTF-16LE (1200) */
        BEGIN
            VALUE "CompanyName",      "BenjmSek"
            VALUE "FileDescription",  "iperf3 GUI V1.1"
            VALUE "FileVersion",      VER_FILEVERSION_STR
            VALUE "InternalName",     "iperf3gui"
            VALUE "OriginalFilename", "iperf3gui.exe"
            VALUE "ProductName",      "iperf3 GUI V1.1"
            VALUE "ProductVersion",   VER_PRODUCTVERSION_STR
            VALUE "LegalCopyright",   "Copyright (c) 2026 BenjmSek. Licensed under the MIT License."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 0x03B0
    END
END
